# Production image for the Nuxt / Nitro API.
# In Coolify: Dockerfile location = Dockerfile.prod, exposed port = 3000.
#
# Set these as runtime environment variables (not build args):
#   NUXT_MONGODB_URI
#   NUXT_OPENAI_API_KEY
#   NUXT_R2_WORKER_URL
#   NUXT_R2_WORKER_SECRET
#   NUXT_JWT_SECRET
#   NUXT_JWT_REFRESH_SECRET

FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY . .
RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV NITRO_HOST=0.0.0.0
ENV PORT=3000
ENV NITRO_PORT=3000

COPY --from=build --chown=node:node /app/.output ./.output

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
	CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", ".output/server/index.mjs"]
