NODE_ENV="development"

# backend
NUXT_MONGODB_URI="mongodb+srv://"
NUXT_OPENAI_API_KEY="sk-proj"
NUXT_JWT_SECRET="replace-with-at-least-32-random-characters"
NUXT_JWT_REFRESH_SECRET="replace-with-a-different-32-plus-random-string"
# not used anymore since we don't store any user files or images in a bucket anymore
NUXT_R2_WORKER_URL="https://<project>-media-gateway.<subdomain>.workers.dev"
NUXT_R2_WORKER_SECRET="your-secure-auth-secret"

# frontend
API_BASE="https://api.example.com"